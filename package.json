{
    "private": true,
    "name": "fet-monorepo",
    "packageManager": "pnpm@9.0.6",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev --concurrency=16",
        "start": "turbo run start --concurrency=16",
        "lint": "turbo run lint",
        "format": "turbo run format",
        "test": "turbo run test",
        "ci": "pnpm run lint && pnpm run build && pnpm run test"
    }, 
    "devDependencies": {
        "turbo": "latest",
        "oxlint": "latest",  
        "oxfmt": "latest" 
    }
}
