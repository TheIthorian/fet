{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["**/.env.*local"],
    "globalEnv": [
        "NODE_ENV",
        "PORT",
        "MONGODB_URI",
        "JWT_SECRET",
        "INTERNAL_KEY",
        "JOURNEY_SERVICE_URL",
        "MAIN_APP_URL",
        "HERE_APP_KEY"
    ],
    "pipeline": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "lint": {},
        "format": {},
        "test": {},
        "dev": {
            "cache": false,
            "persistent": true
        },
        "start": {
            "dependsOn": ["^build"]
        }
    }
}
